{
    "name":  "eva-assistant-pc",
    "version":  "5.4.19",
    "description":  "Assistant Virtuel IA E.V.A â€” Evolutionary Virtual Assistant by Astral Technologie",
    "author":  "Astral Technologie",
    "main":  "dist-electron/main.js",
    "homepage":  "https://eva-assistant.app",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc \u0026\u0026 vite build \u0026\u0026 xcopy /E /I /Y web\\js dist\\js \u0026\u0026 xcopy /E /I /Y web\\assets dist\\assets \u0026\u0026 electron-builder",
                    "build:portable":  "tsc \u0026\u0026 vite build \u0026\u0026 electron-builder --win portable",
                    "preview":  "vite preview",
                    "electron:dev":  "vite",
                    "electron:build":  "vite build \u0026\u0026 electron-builder",
                    "deploy":  "node deploy.js",
                    "postinstall":  "node scripts/download-llm.js \u0026\u0026 electron-builder install-app-deps"
                },
    "dependencies":  {
                         "auto-launch":  "^5.0.6",
                         "cors":  "^2.8.6",
                         "docx":  "^8.5.0",
                         "dompurify":  "^3.1.5",
                         "electron-store":  "^8.1.0",
                         "electron-updater":  "^6.8.9",
                         "express":  "^5.2.1",
                         "firebase":  "^10.12.2",
                         "highlight.js":  "^11.9.0",
                         "marked":  "^12.0.0",
                         "node-pty":  "^1.0.0",
                         "react":  "^19.2.6",
                         "react-dom":  "^19.2.6",
                         "screenshot-desktop":  "^1.15.0",
                         "systeminformation":  "^5.22.10",
                         "zustand":  "^4.5.2"
                     },
    "devDependencies":  {
                            "@types/auto-launch":  "^5.0.5",
                            "@types/dompurify":  "^3.0.5",
                            "@types/node":  "^20.14.0",
                            "@types/react":  "^18.3.3",
                            "@types/react-dom":  "^18.3.0",
                            "@vitejs/plugin-react":  "^4.3.1",
                            "concurrently":  "^8.2.2",
                            "electron":  "^31.7.7",
                            "electron-builder":  "^24.13.3",
                            "png-to-ico":  "^3.0.1",
                            "typescript":  "^5.4.5",
                            "vite":  "^5.3.1",
                            "vite-plugin-electron":  "^0.28.7",
                            "vite-plugin-electron-renderer":  "^0.14.5",
                            "wait-on":  "^7.2.0"
                        },
    "build":  {
                  "appId":  "com.astraltechnologie.eva",
                  "productName":  "EVA Assistant",
                  "copyright":  "Copyright Â© 2025 Astral Technologie. Tous droits rÃ©servÃ©s.",
                  "icon":  "public/eva-icon.png",
                  "asar":  true,
                  "asarUnpack":  [
                                     "node_modules/node-pty/**",
                                     "node_modules/screenshot-desktop/**"
                                 ],
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "public"
                                  },
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*",
                                "public/**/*",
                                "!public/eva-icon-gen.png",
                                "!**/*.map",
                                "!**/*.ts",
                                "!src/**/*"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "public/installer-icon.ico",
                              "artifactName":  "E.V.A-Setup-${version}.exe",
                              "legalTrademarks":  "Astral Technologie",
                              "publisherName":  "Astral Technologie",
                              "verifyUpdateCodeSignature":  false
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "perMachine":  true,
                               "allowElevation":  true,
                               "installerIcon":  "public/installer-icon.ico",
                               "uninstallerIcon":  "public/installer-icon.ico",
                               "uninstallDisplayName":  "EVA Assistant",
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "deleteAppDataOnUninstall":  false
                           },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "urnova",
                                      "repo":  "eva",
                                      "releaseType":  "release"
                                  }
                              ],
                  "compression":  "maximum",
                  "artifactName":  "E.V.A-Setup.exe",
                  "extraResources":  [
                                         {
                                             "from":  "resources/",
                                             "to":  "resources/",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ]
              }
}
