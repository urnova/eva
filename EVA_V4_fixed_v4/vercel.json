{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/js/core/firebase-config.js", "destination": "/api/config" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/chat/cloudworks", "destination": "/chat.html" },
    { "source": "/chat/(.*)", "destination": "/chat.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/(.*)", "destination": "/login.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/onboarding/(.*)", "destination": "/onboarding.html" }
  ],
  "headers": [

    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Frame-Options", "value": "" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/chat.html",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/onboarding.html",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
