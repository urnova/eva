rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isCreator() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isAuth() && doc.exists && doc.data.get('role', 'user') == 'creator';
    }

    // ════ Profils utilisateurs ════
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ════ Sessions Actives ════
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /conversations/{convId} {
        allow read, write: if isOwner(userId);
        match /messages/{msgId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /alarms/{alarmId} {
        allow read, write: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }

      // ════ Statistiques d'utilisation CloudWorks ════
      match /stats/{statDoc} {
        allow read, write: if isOwner(userId);
      }

      // ════ Sessions Vision Réparation ════
      match /visionRepairSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // ════ Sessions Vision Assistance ════
      match /visionAssistSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ════ Rapports / Signalements ════
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth();
    }

    // ════ Clés développeur ════
    match /dev_keys_valid/{keyId} {
      allow read: if isAuth();
      allow create, update, delete: if isCreator();
    }

    // ════ EVA CLOUDWORKS ════
    match /cloudworks/{userId} {
      allow read, write: if isOwner(userId);

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      match /commands/{commandId} {
        allow read, write: if isOwner(userId);
      }
    }

  }
}
